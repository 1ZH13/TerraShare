{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "bun"],
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@terrashare/shared": ["../../packages/shared/src/index.ts"],
      "@backend/*": ["../backend-api/src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "dist", "node_modules"]
}
