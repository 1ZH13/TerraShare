{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode (Vite handles emit) */
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Coexistence with legacy JS during the migration */
    "allowJs": true,
    "checkJs": false,

    /* Linting / strictness for the migrated TS files */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    "types": ["vite/client"],

    /* Shared contracts (DTOs/types) from packages/shared */
    "paths": {
      "@terrashare/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  "include": ["src"]
}
