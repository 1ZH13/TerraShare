VITE_API_BASE_URL=http://localhost:3000
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# En prod:  VITE_API_BASE_URL=https://terrashare.duckdns.org
# En staging: VITE_API_BASE_URL=https://terrashare-test.duckdns.org

# ─── Pruebas E2E con sesión ──────────────────────────────────────────────────
# Las pruebas de `*.authenticated.spec.js` entran con un sign-in ticket que se
# pide a la API de Clerk; no hay contraseñas de por medio. Hacen falta:
#
#   - CLERK_SECRET_KEY: se lee del .env del backend si ya está ahí. En CI, del
#     secreto del repositorio con ese mismo nombre.
#   - E2E_CLERK_TEST_EMAIL: opcional. Por defecto usa la cuenta de pruebas
#     vero.buyer+clerk_test@example.com.
#
# Sin la clave secreta esas pruebas se saltan solas y el resto corre igual.
# E2E_CLERK_TEST_EMAIL=vero.buyer+clerk_test@example.com