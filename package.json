{
  "name": "terrashare",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma para alquiler de terrenos",
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "cd apps/backend-api && npm run dev",
    "dev:web": "cd apps/web && npm run dev",
    "install:all": "npm install && cd apps/backend-api && npm install && cd ../web && npm install",
    "build": "npm-run-all --parallel build:api build:web",
    "build:api": "cd apps/backend-api && npm run build",
    "build:web": "cd apps/web && npm run build"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}